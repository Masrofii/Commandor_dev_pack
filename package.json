{
  "name": "temp-mail-manager",
  "version": "1.0.0",
  "description": "Self-hosted temporary email management platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node -e \"require('./database/database.js').runMigrations()\"",
    "test": "jest --runInBand --forceExit",
    "build": "cd web && npm run build",
    "backup": "node -e \"require('./src/jobs/backups.js').runBackup()\"",
    "cleanup": "node -e \"require('./src/jobs/cleanup.js').runCleanup({dryRun:false})\"",
    "cleanup:dry": "node -e \"require('./src/jobs/cleanup.js').runCleanup({dryRun:true})\""
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "archiver": "^7.0.1",
    "axios": "^1.6.8",
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^9.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dayjs": "^1.11.11",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^7.2.0",
    "express-session": "^1.18.0",
    "express-validator": "^7.0.1",
    "freebuff": "^0.2.30",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mailparser": "^3.7.1",
    "mime-types": "^2.1.35",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "node-forge": "^1.3.1",
    "nodemailer": "^6.9.13",
    "qrcode": "^1.5.3",
    "safe-regex2": "^4.0.0",
    "sanitize-html": "^2.13.0",
    "speakeasy": "^2.0.0",
    "ssh2": "^1.17.0",
    "telegraf": "^4.16.3",
    "uuid": "^9.0.1",
    "winston": "^3.13.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.16.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testTimeout": 30000,
    "transformIgnorePatterns": [
      "/node_modules/(?!.*(htmlparser2|domhandler|domutils|dom-serializer|entities|domelementtype|sanitize-html)/)"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
