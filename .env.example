# ═══════════════════════════════════════════════════════════════
#  Commandor Dev Pack — Environment Configuration
#  Self-Hosted Developer, Infrastructure & Domain Management Platform
#  Copy this file to .env and fill in all required values
#  Never commit .env to version control
# ═══════════════════════════════════════════════════════════════

# ── Core ────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
WEB_PORT=3001
BASE_URL=http://localhost:3000

# ── Security & Encryption ───────────────────────────────────────
# Secret key for encrypting stored credentials (SSH keys, DNS tokens, app env vars)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=
# Generate with: openssl rand -hex 32
SESSION_SECRET=
# Generate with: openssl rand -hex 32
JWT_SECRET=
SESSION_TTL_HOURS=168

# ── Database ────────────────────────────────────────────────────
DATABASE_PATH=./data/app.db

# ── DNS Providers ───────────────────────────────────────────────
# Scoped Cloudflare API Token with Zone.DNS edit permissions
CLOUDFLARE_API_TOKEN=

# ── Telegram Bot (Optional Integration) ─────────────────────────
# Token obtained from @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=CommandorDevBot
NEXT_PUBLIC_BOT_USERNAME=CommandorDevBot
ADMIN_TELEGRAM_ID=
OWNER_USERNAME=xpT_T

# ── Local Administrator Login ───────────────────────────────────
# Enables username/password login without Telegram. The account is created or
# updated at startup. Use a long random password and keep this file private.
LOCAL_AUTH_ENABLED=true
LOCAL_ADMIN_USERNAME=admin
LOCAL_ADMIN_PASSWORD=
# Telegram ID reserved for the local administrator account (must not collide
# with a real Telegram user unless you intend to take over that account).
LOCAL_ADMIN_TG_ID=900000001

# ── Incoming Email Secret ────────────────────────────────────────
# Shared secret between this server and the Cloudflare Worker
# HOW TO GENERATE (Linux/Mac):
#   openssl rand -hex 32
# This value must match INCOMING_SECRET set as a Cloudflare Worker secret
INCOMING_SECRET=

# ── Domains ─────────────────────────────────────────────────────
# Comma-separated list of domains used for alias generation
# These domains must have MX records pointing to Cloudflare Email Routing
# Example: mail.yourdomain.com,temp.yourdomain.com
DOMAINS=
DEFAULT_DOMAIN=

# ── Quotas ──────────────────────────────────────────────────────
MAX_ALIASES=5
MAX_STORAGE_BYTES=104857600
MAX_EMAIL_SIZE=10485760
MAX_ATTACHMENT_SIZE=5242880
MAX_WEBHOOKS=5
MAX_API_KEYS=10
EMAIL_TTL_DAYS=7
ALIAS_TTL_DAYS=30
BURNER_TTL_MINUTES=60

# ── Storage ─────────────────────────────────────────────────────
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads

# Cloudflare R2 (optional — leave blank to use local storage)
# HOW TO GET R2 CREDENTIALS:
#   1. Cloudflare Dashboard → R2 → Create bucket
#   2. Manage R2 API Tokens → Create API Token
#   3. Copy Account ID from R2 overview page
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# ── SMTP (outbound replies and forwarding) ───────────────────────
# HOW TO GET SMTP CREDENTIALS:
#
# Option A — Brevo (free 300 emails/day):
#   https://app.brevo.com → SMTP & API → SMTP tab
#   SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587
#
# Option B — Mailgun:
#   https://app.mailgun.com → Sending → Domain settings → SMTP credentials
#   SMTP_HOST=smtp.mailgun.org  SMTP_PORT=587
#
# Option C — SendGrid:
#   https://app.sendgrid.com → Settings → API Keys → create key
#   SMTP_HOST=smtp.sendgrid.net  SMTP_PORT=587  SMTP_USER=apikey
#
# Option D — Your own Postfix (advanced):
#   SMTP_HOST=127.0.0.1  SMTP_PORT=25  SMTP_SECURE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@yourdomain.com

# ── Web / Session ────────────────────────────────────────────────
WEB_URL=https://mail.yourdomain.com
# Additional browser origins allowed to call the API. WEB_URL and BASE_URL
# are always allowed; localhost is only auto-allowed outside production.
CORS_ORIGINS=https://mail.yourdomain.com
COOKIE_DOMAIN=

# ── Admin 2FA ────────────────────────────────────────────────────
# Issuer name shown in authenticator apps (e.g. Google Authenticator)
ADMIN_2FA_ISSUER=CommandorDevPack

# ── GeoIP (optional) ─────────────────────────────────────────────
# HOW TO GET GeoLite2 DATABASE (free):
#   1. Register at https://dev.maxmind.com/geoip/geolite2-free-geolocation-data
#   2. Download GeoLite2-City.mmdb
#   3. Place at ./data/GeoLite2-City.mmdb
GEOIP_ENABLED=false
GEOIP_DATABASE_PATH=./data/GeoLite2-City.mmdb

# ── Webhooks ─────────────────────────────────────────────────────
WEBHOOK_RETRY_LIMIT=5
WEBHOOK_RETRY_BASE_DELAY_MS=5000

# ── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=./logs

# ── Backups ──────────────────────────────────────────────────────
BACKUP_DIR=./backups
# Keep every backup newer than this, then keep one per day/week within the
# tier windows. The newest backup is always retained.
BACKUP_RETENTION_DAYS=14
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4

# ── Reverse Proxy ────────────────────────────────────────────────
# auto   = validate/reload system Nginx when present, otherwise store a
#          pending route file for an external reloader
# pending = always render route files without touching Nginx
# nginx   = require Nginx and fail when it cannot be validated or reloaded
PROXY_MODE=auto
# Let's Encrypt-style certificate root. HTTPS routes use existing
# <TLS_CERT_DIR>/<domain>/fullchain.pem and privkey.pem files; otherwise routes
# are created HTTP-only and flagged as awaiting a certificate.
TLS_CERT_DIR=/etc/letsencrypt/live

# ── Application Runner ───────────────────────────────────────────
# local = clone, install, build and run applications on this host
# mock  = simulated deployments for demos/tests only
APP_RUNNER=local
APP_DEPLOY_DIR=./data/apps
# New applications default to port 8080. Ports 80, 443, PORT, and WEB_PORT are
# reserved for the platform and are rejected before a process is started.
APP_COMMAND_TIMEOUT_MS=600000
APP_START_TIMEOUT_MS=45000
# Running user-supplied build/start commands is equivalent to shell access.
# Keep this false unless every application owner is trusted.
APP_ALLOW_USER_DEPLOYMENTS=false

# ── Outbound Security ────────────────────────────────────────────
# Allow webhooks and proxy targets to resolve to private/loopback addresses.
# Leave false on Internet-facing installations.
ALLOW_PRIVATE_OUTBOUND=false
# Override automatic public-IP detection used in DNS setup instructions.
SERVER_PUBLIC_IP=
TRUST_PROXY=1

# ── Health Alerts ────────────────────────────────────────────────
HEALTH_ALERT_DISK_PERCENT=90
HEALTH_ALERT_MEMORY_PERCENT=90

# Discord webhook URL for alert notifications (optional)
# HOW TO GET:
#   Discord server → channel settings → Integrations → Webhooks → New Webhook
DISCORD_ALERT_WEBHOOK=

# ── ClamAV Antivirus (optional) ──────────────────────────────────
# HOW TO INSTALL:
#   apt install clamav clamav-daemon && systemctl start clamav-daemon
CLAMAV_ENABLED=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# ── Spam Scoring ─────────────────────────────────────────────────
SPAM_THRESHOLD_SCORE=5
SPAM_BLOCK_SCORE=8
